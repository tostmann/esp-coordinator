/sdkconfig.old
/dependencies.lock
/sdkconfig
/managed_components/
/build/
/zigbee2mqtt/
/esp-zigbee-sdk/
/mosquitto.conf
/*.log
/*.json
/CLAUDE.md
/GEMINI.md
/FACTS.md
/MEMORY.md
/HARDWARE_STATUS.md
/patch*.py
/pr*.patch
/probe_stick.py
/read_*.py
/run_pairing_test.py
/z2m.install.hint
/.deploy_key
/.deploy_key.pub
/idf_env.sh
/binaries/*
!/binaries/factory.bin
!/binaries/factory-c5.bin
!/binaries/factory-h2.bin
/main/*.orig
/main/*.rej

# Test scaffolding for rollout_check.sh — vendor-copied IDF example projects
# and shared ZCL helpers used to spin up a transient end-device on a second
# ESP32-C6 during integration testing. Not part of the firmware release;
# developers reconstruct from upstream Espressif examples when needed.
/HA_on_off_light/
/HA_on_off_switch/
/common/

# v6 IDF env wrapper (parallel to idf_env.sh, host-local)
/idf_env.v6.sh

# Agent harness state — session IDs, PIDs, scheduled-task locks. Must
# never be tracked: bump_build.sh-style pre-build hooks otherwise sweep
# scheduled_tasks.lock etc. into snapshot commits (cf. EULFW32 incident
# 2026-05-20 with .claude/scheduled_tasks.lock landing in v0.3.122).
/.claude/
/.gemini/
/.geminignore

# Atomic-write temp siblings from scripts/bump_build.sh (version.txt.tmp,
# build_number.txt.tmp). Normally removed by os.replace; a stale one left by a
# mid-write crash must not be swept into a snapshot by the hook's `git add -A`.
*.tmp
__pycache__/

# stray build objects / lab artefacts (accidental adds 2026-06)
*.obj
LAB_WIFI*

# test/ is the dumping ground for runtime artefacts — captures, logs, run
# reports, probe scripts written for one investigation, drafts of forum and
# issue replies. None of that belongs on the public remote, and the pre-build
# hook's `git add -A` would otherwise sweep it into snapshot commits (it did,
# repeatedly). Ignore the directory and whitelist the few files that earn their
# place: things a USER needs (remediation tools) or that the docs reference.
# Anything else stays local. Add to the whitelist deliberately, never by habit.
/test/*
!/test/README.md
!/test/rollout_check.sh
!/test/bind_table_tool.py
!/test/usj_tcp_bridge.py
!/test/dup_drop_check.py
!/test/getset_ext_pan_check.py
!/test/permit_bcast_status_probe.py
!/test/permit_gate_check.py
!/test/routing_gate_check.py
!/test/smoke_structured_backup.py
