# Test scaffolding for rollout_check.sh — vendor-copied IDF example projects
# and shared ZCL helpers used to spin up a transient end-device on a second
# ESP32-C6 during integration testing. Not part of the firmware release;
# developers reconstruct from upstream Espressif examples when needed.
/HA_on_off_light/
/HA_on_off_switch/
/common/

# v6 IDF env wrapper (parallel to idf_env.sh, host-local)
/idf_env.v6.sh

# Agent harness state — session IDs, PIDs, scheduled-task locks. Must
# never be tracked: bump_build.sh-style pre-build hooks otherwise sweep
# scheduled_tasks.lock etc. into snapshot commits (cf. EULFW32 incident
# 2026-05-20 with .claude/scheduled_tasks.lock landing in v0.3.122).
/.claude/
/.gemini/
/.geminignore

# Local working notes from code review (internal, not a release artifact).
/test/CODE_REVIEW_FOLLOWUP.md

# Atomic-write temp siblings from scripts/bump_build.sh (version.txt.tmp,
# build_number.txt.tmp). Normally removed by os.replace; a stale one left by a
# mid-write crash must not be swept into a snapshot by the hook's `git add -A`.
*.tmp
__pycache__/

# stray build objects / lab artefacts (accidental adds 2026-06)
*.obj
LAB_WIFI*

# Voll-Dumps fremder Stick-Firmware vor Umwidmung (4 MB Binaerblobs,
# Lab-Artefakte — Prozedur/README bleibt getrackt, die .bin nicht).
/test/stick_backups/*.bin
